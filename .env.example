# ─── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talentflow?schema=public"

# ─── Authentication ────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Email (Resend) ───────────────────────────────────
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="TalentFlow <noreply@yourdomain.com>"

# ─── Payments (Stripe Test Mode) ──────────────────────
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ─── App Config ────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TalentFlow"

# ─── AI Agents ─────────────────────────────────────────
# Provider model: "gemini" (gratis) | "ollama" (lokal) | "mock" (test)
MODEL_PROVIDER="gemini"
GEMINI_API_KEY=""
MODEL_FAST="gemini-2.5-flash"
MODEL_DEEP="gemini-2.5-flash"
OLLAMA_BASE_URL="http://localhost:11434"
# Secret untuk endpoint cron declarative (/api/cron/agents)
CRON_SECRET="generate-with-openssl-rand-base64-32"

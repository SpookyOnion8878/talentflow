# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/talentflow?schema=public"

# Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
SEED_DEMO_PASSWORD=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email (Resend)
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="TalentFlow <noreply@yourdomain.com>"

# Payments (Stripe test mode)
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Application configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TalentFlow"

# AI agents
# Model provider: "gemini" (external) | "ollama" (local) | "mock" (test)
MODEL_PROVIDER="gemini"
GEMINI_API_KEY=""
MODEL_FAST="gemini-2.5-flash"
MODEL_DEEP="gemini-2.5-flash"
OLLAMA_BASE_URL="http://localhost:11434"
# External providers stay blocked unless both settings explicitly allow a company.
AI_EXTERNAL_DATA_PROCESSING="false"
AI_EXTERNAL_DATA_COMPANY_ALLOWLIST=""
# Secret for the declarative cron endpoint (/api/cron/agents); use at least 32 characters.
CRON_SECRET="generate-with-openssl-rand-base64-32"
# Set to true only when a trusted reverse proxy sanitizes forwarded client IP headers.
TRUSTED_PROXY="false"
